#include <stdio.h>

int main() {
    int age;
    printf("Enter your age: ");
    scanf("%d", &age);
    if (age <= 0) {
        printf("Invalid age entered.\n");
    } else if (age >= 18) {
        printf("You are eligible to vote.\n");
    } else {
        printf("You are NOT eligible to vote yet. (You need %d more year(s))\n", 18 - age);
    }

    return 0;
}
