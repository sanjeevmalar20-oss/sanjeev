#include <stdio.h>

int main() {
    long long num, originalNum, reversedNum = 0, remainder;

   
    printf("Enter an integer: ");
    scanf("%lld", &num);

    originalNum = num; // Save original value for final comparison

    
    long long temp = num < 0 ? -num : num;

    while (temp != 0) {
        remainder = temp % 10;
        reversedNum = reversedNum * 10 + remainder;
        temp /= 10;
    }
    if (num >= 0 && originalNum == reversedNum) {
        printf("%lld is a Palindrome.\n", originalNum);
    } else {
        printf("%lld is NOT a Palindrome.\n", originalNum);
    }

    return 0;
}
