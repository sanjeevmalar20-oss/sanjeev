#include <stdio.h>

int main() {
    long long num, temp;
    int count = 0;

    printf("Enter an integer: ");
    scanf("%lld", &num);

    temp = num; // Save original value

    if (temp == 0) {
        count = 1;
    } else {
        while (temp != 0) {
            temp /= 10; // Remove the last digit
            count++;    // Increment digit counter
        }
    }

    printf("Number of digits in %lld = %d\n", num, count);

    return 0;
}
