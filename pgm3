#include <stdio.h>

int main() {
    float marks[5];
    float total = 0.0, average;
    int i;
    printf("Enter marks for 5 subjects:\n");
    for (i = 0; i < 5; i++) {
        printf("Subject %d: ", i + 1);
        scanf("%f", &marks[i]);
        total += marks[i]; // Accumulate total
    }
    average = total / 5;
    printf("\n--- Results ---\n");
    printf("Total Marks: %.2f\n", total);
    printf("Average Marks: %.2f\n", average);

    return 0;
}
