#include <stdio.h>

int main() {
    int N, i, sum = 0;

    
    printf("Enter a positive integer N: ");
    scanf("%d", &N);

    if (N < 1) {
        printf("Please enter an integer greater than or equal to 1.\n");
        return 1;
    }

    
    for (i = 1; i <= N; i++) {
        sum += i;
    }

    printf("Sum of numbers from 1 to %d = %d\n", N, sum);

    return 0;
}
